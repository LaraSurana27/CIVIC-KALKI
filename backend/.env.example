# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Use the exact Supabase Session Pooler URI from Dashboard > Connect.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters — server will refuse to start otherwise.
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h

# Obtain from Google AI Studio when the AI endpoint is implemented.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins (used for CORS + CSRF).
# Default includes http://localhost:5173. Add your Vercel/production URL here.
FRONTEND_ORIGIN=http://localhost:5173

# Legacy alias still accepted for backward compat (optional, same value as above).
FRONTEND_URL=http://localhost:5173

# Number of trusted reverse-proxy hops in front of this server.
# Set to 1 for Render/Railway/Vercel; 0 for direct connections (local dev default).
TRUST_PROXY_HOPS=1
