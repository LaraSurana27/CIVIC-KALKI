# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000

# Use the exact Supabase Session Pooler URI from Dashboard > Connect.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be at least 32 characters — server will refuse to start otherwise.
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h

# Obtain from Google AI Studio when the AI endpoint is implemented.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins (used for CORS + CSRF).
# Default includes http://localhost:5173. Add your Vercel/production URL here.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend origin used by CORS configuration (legacy alias).
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Groq AI — Coordinator/Authority AI Module (Ayush's Module)
# ─────────────────────────────────────────────────────────────
# Obtain a free API key from: https://console.groq.com/keys
# Docs: https://console.groq.com/docs/api-reference
# Models: https://console.groq.com/docs/models
# Rate limits: https://console.groq.com/docs/rate-limits
#
# IMPORTANT: Never commit this key or expose it to client-side code.
# Free tier rate limits apply (e.g., ~30 req/min for llama-3.3-70b-versatile on Free tier).
# The free tier is NOT unlimited — check current limits on the Groq console.
#
# Recommended model: llama-3.3-70b-versatile (verified available as of Oct 2026)
# Alternative: llama-3.1-8b-instant (faster, lower quality)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Number of trusted reverse-proxy hops in front of this server.
# Set to 1 for Render/Railway/Vercel; 0 for direct connections (local dev default).
TRUST_PROXY_HOPS=1
