{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CivicKalkiEntityTypeMetadata",
  "type": "object",
  "required": ["domain", "entity_type", "form", "workflow", "rules"],
  "properties": {
    "domain": {
      "type": "object",
      "required": ["key", "name"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "entity_type": {
      "type": "object",
      "required": ["key", "name", "description"],
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "verified": { "type": "boolean" },
        "verification_note": { "type": "string" }
      }
    },
    "form": {
      "type": "object",
      "required": ["name", "sections"],
      "properties": {
        "name": { "type": "string" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "subsections"],
            "properties": {
              "key": { "type": "string" },
              "name": { "type": "string" },
              "display_order": { "type": "integer" },
              "subsections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["name", "parameters"],
                  "properties": {
                    "name": { "type": "string" },
                    "parameters": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["field_key", "label", "field_type", "mandatory"],
                        "properties": {
                          "field_key": { "type": "string" },
                          "label": { "type": "string" },
                          "field_type": {
                            "type": "string",
                            "enum": ["text", "textarea", "number", "date", "time", "boolean", "enum", "multi_enum", "phone", "geo_point", "file", "select", "checkbox"]
                          },
                          "control_type": { "type": "string" },
                          "mandatory": { "type": "boolean" },
                          "validation_rule": { "type": "string" },
                          "help_text": { "type": "string" },
                          "visibility_rule": { "type": "object" },
                          "options": { "type": "object" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["initial_state", "states", "transitions"],
      "properties": {
        "initial_state": { "type": "string" },
        "states": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["key", "label", "terminal"],
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "terminal": { "type": "boolean" },
              "sla_hours": { "type": "number" }
            }
          }
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "to", "action", "allowed_roles"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "action": { "type": "string" },
              "allowed_roles": {
                "type": "array",
                "items": { "type": "string" }
              },
              "guards": {
                "type": "array",
                "items": { "type": "string" }
              },
              "aggregation_policy": { "type": "string" },
              "side_effects": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "authority_routing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "authority_key", "condition"],
            "properties": {
              "id": { "type": "string" },
              "authority_key": { "type": "string" },
              "description": { "type": "string" },
              "condition": { "type": "object" },
              "matched_input_fields": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "output_format"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "output_format": { "type": "string" },
          "filters": { "type": "object" }
        }
      }
    }
  }
}
