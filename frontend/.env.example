# Copy this file to .env and fill in the values. Never commit .env.

# Map tile server URL template (OpenStreetMap default shown).
# Replace with your own tile server URL for production to respect OSM usage policy.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Map tile attribution string (required by OSM license).
VITE_MAP_ATTRIBUTION=© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Backend API base URL (proxied via Vite in development, direct URL in production).
# In development the vite.config.js proxy rewrites /api -> http://localhost:3000.
# In production, set this to your deployed backend URL.
VITE_API_BASE=/api
